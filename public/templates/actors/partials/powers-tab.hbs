<section
  class='{{tab.tabCssClass}} {{tab.id}}'
  data-group='{{tab.group}}'
  data-tab='{{tab.id}}'
>
  {{#*inline "powerEntry"}}
    <li class="power-card power item" data-item-id="{{id}}" data-arcane="{{#if system.arcane}}{{system.arcane}}{{else}}general{{/if}}" data-document-class="Item">
      <header class="card-header flexrow">
        <div class="item-image" style="background-image: url('{{img}}')"></div>
        <h4 class="item-name">{{name}}</h4>
        {{#if isOwner}}
          <div class="item-controls flexrow">
            <a class="item-show" data-action="showItem"><i class="fas fa-eye"></i></a>
            <a class="item-edit" data-action='openItem'><i class="fas fa-edit"></i></a>
          </div>
        {{/if}}
      </header>
      <div class="card-content collapsed">
        <div class="power-content">
          <div>
            <div class="power-details">
              <div class="flexrow">
                {{#if system.rank}}
                <div>{{localize 'SWADE.Rank'}}:&nbsp;{{system.rank}}</div>
                {{/if}} {{#if system.pp}}
                <div>{{localize 'SWADE.PP'}}:&nbsp;{{system.pp}}</div>
                {{/if}}
              </div>
              <div class="flexrow">
                {{#if system.range}}
                <div>{{localize 'SWADE.Range._name'}}:&nbsp;{{system.range}}</div>
                {{/if}} {{#if system.duration}}
                <div>{{localize 'SWADE.Dur'}}:&nbsp;{{system.duration}}</div>
                {{/if}}
              </div>
              <div class="flexrow">
                {{#if system.damage}}
                <div>{{localize 'SWADE.Dmg'}}:&nbsp;<a class="damage-roll">{{system.damage}}</a></div>
                {{/if}} {{#if system.ap}}
                <span>{{localize "SWADE.Ap"}}:&nbsp;{{system.ap}}</span>
                {{/if}}
              </div>
            </div>
            {{#if system.trapping}}
              <div class="trapping">{{localize "SWADE.Trapping"}}:&nbsp;{{system.trapping}}</div>
            {{/if}}
            <div class="power-description">{{{enrichedDescription}}}</div>
          </div>
        </div>
      </div>
    </li>
  {{/inline}}
  <div class="flexrow form-group header-field">
    <div class="arcane-tabs">
      {{#if powers.showGeneral}}
        <div class="arcane" data-arcane="general" data-action="filterPowers">{{localize "SWADE.General"}}</div>
      {{/if}}
      {{#each powers.arcaneBackgrounds as |background key|}}
        {{#unless (eq key "general")}}
          <div class="arcane" data-arcane="{{key}}" data-action="filterPowers">{{key}}</div>
        {{/unless}}
      {{/each}}
    </div>
    <!-- Global counter -->
    {{#unless settingrules.noPowerPoints}}
      <div class="power-counter" data-arcane="general">
        <label>{{localize "SWADE.PP"}}</label>
        <input
          name="system.powerPoints.general.value"
          type="number"
          value="{{actor.system.powerPoints.general.value}}"
          placeholder="{{localize 'SWADE.CurPP'}}"
          data-dtype="Number"
        />
        <span>/</span>
        <input
          name="system.powerPoints.general.max"
          type="number"
          value="{{actor.system.powerPoints.general.max}}"
          placeholder="{{localize 'SWADE.MaxPP'}}"
          data-dtype="Number"
        />    
        <button type="button" class="adjust-counter" data-action="pp-refresh" data-arcane="general" data-tooltip="{{localize "SWADE.RefreshPP"}}">
          <i class="fa-solid fa-arrows-rotate"></i>
        </button>
      </div>
      <!-- Individual counters -->
      {{#each powers.arcaneBackgrounds as |background key|}}
        {{#unless (eq key "general")}}
          <div class="power-counter" data-arcane="{{key}}">
            <label>{{localize "SWADE.PP"}}</label>
            <input
              name="{{background.valuePath}}"
              type="number"
              value="{{background.value}}"
              placeholder="{{localize 'SWADE.CurPP'}}"
              data-dtype="Number"
            />
            <span>/</span>
            <input
              name="{{background.maxPath}}"
              type="number"
              value="{{background.max}}"
              placeholder="{{localize 'SWADE.MaxPP'}}"
              data-dtype="Number"
            />     
            <button type="button" class="adjust-counter" data-action="pp-refresh" data-arcane="{{key}}" data-tooltip="{{localize "SWADE.RefreshPP"}}">
              <i class="fa-solid fa-arrows-rotate"></i>
            </button>
          </div>
        {{/unless}}
      {{/each}}
    {{/unless}}
    <div class="header-field-add">
      <a class="item-create" data-action='createDocument' data-render-sheet='true' data-document-class='Item' data-type="power"><i class="fa fa-plus"></i></a>
    </div>
  </div>
  <div class="quickaccess-list">
    <powers class="powers-list">
      {{#each powers.arcaneBackgrounds as |background key|}}
        {{#each background.powers}}
          {{> "powerEntry"}}
        {{/each}}
      {{/each}}
    </powers>
  </div>
</section>