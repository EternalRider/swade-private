<div class="effects-list">
    <div class="swadehud-item-list">
      {{#if sheetEffects.temporary}}
      <div class="effects-section">
        <header class="swadehud-section-header">
          <span class="swadehud-section-name">{{localize 'SWADE.EffectsTemporary'}}</span>
        </header>
        {{#each sheetEffects.temporary as |effect|}}
        <div class="swadehud-item" data-effect-id="{{effect.id}}">
          <div class="swadehud-item-header" data-toggle="expand">
            <img class="swadehud-item-icon" src="{{effect.img}}" alt="{{effect.name}}" />
            <span class="swadehud-item-name" data-tooltip="SWADE.HUD.ExpandTooltip">{{effect.name}} {{#if effect.duration.rounds}}{{localize 'SWADE.HUD.AERounds' rounds=effect.duration.rounds}}{{/if}}</span>
            {{#if effect.duration}}
              <span class="effect-duration">{{effect.duration.label}}</span>
            {{/if}}
        <i class="fa-solid fa-power-off swadehud-effect-toggle-icon{{#unless effect.isEmbedded}} swadehud-effect-toggle-disabled{{/unless}}"
          data-effect-id="{{effect.id}}"
          data-action="toggle"
          data-toggle="disabled"
          data-tooltip="{{#if effect.isEmbedded}}{{localize 'SWADE.HUD.AEToggle' name=effect.name}}{{else}}{{localize 'SWADE.HUD.AEToggleInherited'}}{{/if}}"
          {{#unless effect.isEmbedded}}style="pointer-events:none;opacity:0.5;" aria-disabled="true" tabindex="-1"{{/unless}}></i>
          </div>
          <div class="swadehud-item-content">
            {{#if effect.description}}
              <div class="swadehud-item-description">{{{effect.description}}}</div>
            {{else}}
              <div class="swadehud-item-description swadehud-no-description">{{localize 'SWADE.NoDescription'}}</div>
            {{/if}}
          </div>
        </div>
        {{/each}}
      </div>
      {{/if}}
      
      {{#if sheetEffects.permanent}}
      <div class="effects-section">
        <header class="swadehud-section-header">
          <span class="swadehud-section-name">{{localize 'SWADE.EffectsPermanent'}}</span>
        </header>
        {{#each sheetEffects.permanent as |effect|}}
        <div class="swadehud-item" data-effect-id="{{effect.id}}">
          <div class="swadehud-item-header" data-toggle="expand">
            <img class="swadehud-item-icon" src="{{effect.img}}" alt="{{effect.name}}" />
            <span class="swadehud-item-name" data-tooltip="SWADE.HUD.ExpandTooltip">{{effect.name}}</span>
            <i class="fa-solid fa-power-off swadehud-effect-toggle-icon"
               data-effect-id="{{effect.id}}"
               data-action="toggle"
               data-toggle="disabled"
               data-tooltip="{{localize 'SWADE.HUD.AEToggleTooltip' name=effect.name}}"></i>
          </div>
          <div class="swadehud-item-content">
            {{#if effect.description}}
              <div class="swadehud-item-description">{{{effect.description}}}</div>
            {{else}}
              <div class="swadehud-item-description swadehud-no-description">{{localize 'SWADE.NoDescription'}}</div>
            {{/if}}
          </div>
        </div>
        {{/each}}
      </div>
      {{/if}}
      
      {{#if (and (not sheetEffects.temporary.length) (not sheetEffects.permanent.length))}}
        <div class="swadehud-item no-effects">
          <div class="swadehud-item-header">
            <span class="swadehud-item-name">{{localize 'SWADe.HUD.AENoEffects'}}</span>
          </div>
        </div>
      {{/if}}
    </div>
  </div>
