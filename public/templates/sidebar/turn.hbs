{{! <!--  eslint-disable @html-eslint/require-li-container --> }}
<li class="combatant {{ css }}" data-combatant-id="{{ id }}">
  {{!-- Foundry TODO: Targets --}}

  {{!-- Image --}}
  <img class="token-image" src="{{ img }}" alt="{{ name }}" loading="lazy">

  {{!-- Name & Controls --}}
  <div class="token-name">
    <strong class="name">
      {{#if isLeader}}<i class="fa-solid fa-helmet-battle"></i>{{/if}}
      {{ name }}
    </strong>
    <div class="combatant-controls">
      {{#if @root.user.isGM}}
      <button type="button" class="inline-control combatant-control icon fa-solid fa-eye-slash {{#if hidden}}active{{/if}}" data-action="toggleHidden" data-tooltip="COMBATANT.ToggleVis" aria-label="{{ localize "COMBATANT.ToggleVis" }}"></button>
      <button type="button" class="inline-control combatant-control icon fa-solid fa-skull {{#if isDefeated}}active{{/if}}" data-action="toggleDefeated" data-tooltip="COMBATANT.ToggleDead" aria-label="{{ localize "COMBATANT.ToggleDead" }}"></button>
      {{/if}}
      {{#if canPing}}
      <button type="button" class="inline-control combatant-control icon fa-solid fa-bullseye-arrow" data-action="pingCombatant" data-tooltip="COMBATANT.Ping" aria-label="{{ localize "COMBATANT.Ping" }}"></button>
      {{/if}}
      {{#unless @root.user.isGM}}
        <button type="button" class="inline-control combatant-control icon fa-solid fa-arrows-to-eye" data-action="panToCombatant" data-tooltip="Ping.PanTo" aria-label="{{ localize "Ping.PanTo" }}"></button>
    {{/unless}}
      {{#if @root.combat.started}}
        {{#if (and active isOwner)}}
          {{#unless (or (gt @root.combat.round roundHeld) turnLost group)}}
          <button type="button" class="inline-control combatant-control icon fa-solid fa-hand-back-fist {{#if isOnHold}}active{{/if}}" data-action="toggleHold" data-tooltip="SWADE.Hold"></button>
          {{/unless}}
        {{/if}}

        {{#if @root.user.isGM}}
          {{#if (or isOnHold turnLost)}}
          <button type="button" class="inline-control combatant-control icon fa-solid fa-ban {{#if turnLost}}active{{/if}}" data-action="toggleTurnLost" data-tooltip="SWADE.LoseTurn"></button>
          {{/if}}

          {{#if isOnHold}}
            {{#unless (and (eq @root.combat.round roundHeld) active)}}
            <button type="button" class="inline-control combatant-control icon fa-solid fa-long-arrow-alt-right" data-action="actNow" data-tooltip="SWADE.ActBeforeCurrentCombatant"></button>
            <button type="button" class="inline-control combatant-control icon fa-solid fa-level-down-alt" data-action="actAfter" data-tooltip="SWADE.ActAfterCurrentCombatant"></button>
            {{/unless}}
          {{/if}}
        {{/if}}
      {{/if}}
      {{!-- Foundry TODO: Target Control --}}
      <div class="token-effects" data-tooltip="{{ effects.tooltip }}">
        {{#each effects.icons}}
        <img class="token-effect" src="{{ img }}" alt="{{ name }}">
        {{/each}}
      </div>
    </div>
  </div>

  {{!-- Resource --}}
  {{#if resource includeZero=true}}
  <div class="token-resource">
    <span class="resource">{{ resource }}</span>
  </div>
  {{/if}}

  {{#unless group}}
  {{!-- Initiative --}}
  <div class="token-initiative">
    {{#if roundHeld}}
    <span class="initiative"><i class="fa-solid fa-hand-back-fist"></i></span>
    {{else if turnLost}}
    <span class="initiative"><i class="fa-solid fa-ban"></i></span>
    {{else if hasRolled}}
        {{#if canRedraw}}
        <button type="button" class="combatant-control roll initiative" data-action="redrawInitiative" data-tooltip="SWADE.Redraw" aria-label="{{localize 'SWADE.Redraw'}}">{{{cardString}}}</button>
        {{else}}
        <span class="initiative">{{{cardString}}}</span>
        {{/if}}
    {{else if (and canDrawInit (not initiative))}}
    <button type="button" class="combatant-control roll" data-action="rollInitiative" data-tooltip="SWADE.DrawInit" aria-label="{{localize 'SWADE.DrawInit'}}"></button>
    {{else}}
    <span class="initiative"></span>
    {{/if}}
  </div>
  {{/unless}}
</li>
