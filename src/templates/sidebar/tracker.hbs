<ol class="combat-tracker ds-default">
  {{#each groupTurns}}
  {{#if isGroup}}
  <li class="combatant-group {{css}}" data-group-id="{{id}}">
    <header class="group-header">
      <img class="token-image" src="{{ img }}" alt="{{ name }}" loading="lazy" data-action="toggleGroupExpand" data-group-id="{{id}}">
      <div class="token-name" data-action="toggleGroupExpand" data-group-id="{{id}}">
        <strong class="name">{{ name }}</strong>
      </div>
      {{!-- Initiative --}}
      <div class="token-initiative">
        {{#if roundHeld}}
        <span class="initiative"><i class="fa-solid fa-hand-back-fist"></i></span>
        {{else if turnLost}}
        <span class="initiative"><i class="fa-solid fa-ban"></i></span>
        {{else if hasRolled}}
            {{#if canRedraw}}
            <button type="button" class="initiative dealt" data-action="redrawInitiative" data-tooltip="SWADE.Redraw" aria-label="{{localize 'SWADE.Redraw'}}">{{{cardString}}}</button>
            {{else}}
            <span class="initiative">{{{cardString}}}</span>
            {{/if}}
        {{else if (and canDrawInit (not initiative))}}
        <button class="combatant-control roll" data-action="drawInitiative" data-tooltip="{{localize 'SWADE.DrawInit'}}"></button>
        {{else}}
        <span class="initiative"></span>
        {{/if}}
      </div>
    </header>
    <ol class="group-turns">
      {{#each turns}}
      {{> "systems/swade/templates/sidebar/turn.hbs"}}
      {{/each}}
    </ol>
  </li>
  {{else}}
  {{> "systems/swade/templates/sidebar/turn.hbs"}}
  {{/if}}
  {{/each}}
</ol>
