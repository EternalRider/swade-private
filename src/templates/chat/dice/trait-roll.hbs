<div class='swade-roll'>
  {{#unless isPrivate}}
    {{#if groupRoll}}
      <div class='group-roll'>
        <i class='fa-duotone fa-user-group'></i>
        {{localize 'SWADE.GroupRoll'}}
      </div>
    {{/if}}
    {{#if rerolled}}<div class='reroll'>{{rerolled}}</div>{{/if}}
    {{#if modifiers.length}}
      <details class='modifiers'>
        <summary>{{localize 'SWADE.Modifiers'}}</summary>
        <span class='content'>
          <ol class='modifier-list'>
            {{#each modifiers}}
              <li>{{label}}: {{value}}</li>
            {{/each}}
          </ol>
        </span>
      </details>
    {{/if}}
    {{#if isCritfail}}
      <p class='critical-failure'>{{localize 'SWADE.Critfail'}}</p>
    {{/if}}
  {{/unless}}
  <div class='dice-roll trait-roll'>
    {{!-- {{#if flavor}}<div class='dice-flavor'>{{flavor}}</div>{{/if}} --}}
    <div class='dice-result'>
      <div class='dice-formula'>
        {{#if isPrivate}}???{{else}}
          <ol class='formula-list'>
            {{#each formulaParts}}
              {{#if die}}
                <li
                  class='die'
                  style='background-image: url({{img}});'
                  data-tooltip='{{hint}}'
                >
                  <span class='{{class}}'>{{this.result}}</span>
                </li>
              {{else}}
                <li data-tooltip='{{hint}}'>{{result}}</li>
              {{/if}}
            {{/each}}
          </ol>
        {{/if}}
      </div>
      {{#unless isPrivate}}{{{tooltip}}}{{/unless}}
      <div class='dice-total'>
        {{#if isPrivate}}???{{else}}
          <ol class='result-list'>
            {{#each resultParts}}
              <li
                class='die'
                style='background-image: url({{img}});'
                data-tooltip='{{hint}}'
              >
                <span class='label {{class}}'>{{this.result}}</span>
              </li>
            {{/each}}
          </ol>
        {{/if}}
      </div>
    </div>
  </div>
  <div class='roll-interaction'>
    {{#unless isPrivate}}
      <button
        type='button'
        class='benny-reroll'
        data-tooltip='{{localize "SWADE.RerollWithBenny"}}'
        aria-label='{{localize "SWADE.RerollWithBenny"}}'
      >
        <i class='fa-solid fa-dice'></i>
        Benny
      </button>
      {{#if isGM}}
        <button
          type='button'
          class='benny-reroll'
          data-gm-benny='true'
          data-tooltip='{{localize "SWADE.RerollWithBenny"}}'
          aria-label='{{localize "SWADE.RerollWithBenny"}}'
        >
          <i class='fa-solid fa-dice'></i>
          GM Benny
        </button>
      {{/if}}
      <button
        type='button'
        class='free-reroll'
        data-tooltip='{{localize "SWADE.FreeReroll"}}'
        aria-label='{{localize "SWADE.FreeReroll"}}'
      >
        <i class='fa-solid fa-dice'></i>
        Free
      </button>
    {{/unless}}
  </div>
</div>