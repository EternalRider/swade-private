<div class='swade-roll'>
  {{#unless isPrivate}}{{/unless}}
  <div class='dice-roll trait-roll'>
    {{#if flavor}}<div class='dice-flavor'>{{flavor}}</div>{{/if}}
    <div class='dice-result'>
      <div class='dice-formula'>
        {{#if isPrivate}}???{{else}}
          <ol class='formula-list'>
            {{#each formulaParts}}
              {{#if die}}
                <li
                  class='die'
                  style='background-image: url({{img}});'
                  data-tooltip='{{hint}}'
                >
                  <span class='{{class}}'>{{this.result}}</span>
                </li>
              {{else}}
                <li data-tooltip='{{hint}}'>{{result}}</li>
              {{/if}}
            {{/each}}
          </ol>
        {{/if}}
      </div>
      {{#unless isPrivate}}{{{tooltip}}}{{/unless}}
      <div class='dice-total'>
        {{#if isPrivate}}???{{else}}
          <ol class='result-list'>
            {{#each resultParts}}
              <li
                class='die'
                style='background-image: url({{img}});'
                data-tooltip='{{hint}}'
              >
                <span class='label {{class}}'>{{this.result}}</span>
              </li>
            {{/each}}
          </ol>
        {{/if}}
      </div>
    </div>
  </div>
</div>