<div class='swade-roll'>
  {{#unless isPrivate}}
    {{#if modifiers.length}}
      <details class='modifiers'>
        <summary>{{localize 'SWADE.Modifiers'}}</summary>
        <span class='content'>
          <ol class='modifier-list'>
            {{#each modifiers}}
              <li>{{label}}: {{value}}</li>
            {{/each}}
          </ol>
        </span>
      </details>
    {{/if}}
  {{/unless}}
  <div class='dice-roll'>
    <div class='dice-result'>
      <div class='dice-formula'>
        {{#if isPrivate}}???{{else}}
          <ol class='formula-list'>
            {{#each formulaParts}}
              {{#if die}}
                <li
                  class='die'
                  style='background-image: url({{img}});'
                  data-tooltip='{{hint}}'
                >
                  <label class='{{class}}'>{{this.result}}</label>
                </li>
              {{else}}
                <li data-tooltip='{{hint}}'>{{result}}</li>
              {{/if}}
            {{/each}}
          </ol>
        {{/if}}
      </div>
      {{#unless isPrivate}}{{{tooltip}}}{{/unless}}
      <div class='dice-total'>
        {{#if isPrivate}}???{{else}}{{total}}{{/if}}
      </div>
    </div>
  </div>
</div>