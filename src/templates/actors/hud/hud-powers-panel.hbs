{{!-- Powers Panel Template --}}
<div class="powers-panel">
  <div class="swadehud-item-list">
    {{#each groupedPowers as |powers arcane|}}
      <div class="swadehud-arcane-group">
        <header class="swadehud-section-header">
          <span class="swadehud-section-name">{{arcane}}</span>
          {{#if (eq arcane "General")}}
            {{#with (lookup ../powerPoints "General") as |pp|}}
              <span class="swadehud-pp-indicator swadehud-stat-clickable"
                    title="Power Points: {{pp.value}}/{{pp.max}} (Left click: -1, Right click: +1)"
                    data-stat-path="system.powerPoints.General.value"
                    data-stat-min="0"
                    data-stat-max="{{#if (gt pp.max 0)}}{{pp.max}}{{/if}}">
                <i class="fa-solid fa-bolt-lightning"></i> {{pp.value}}/{{pp.max}}
              </span>
            {{else}}
              <span class="swadehud-pp-indicator swadehud-stat-clickable"
                    title="Power Points: 0/0 (Left click: -1, Right click: +1)"
                    data-stat-path="system.powerPoints.General.value"
                    data-stat-min="0">
                <i class="fa-solid fa-bolt-lightning"></i> 0/0
              </span>
            {{/with}}
          {{else}}
            {{#with (lookup ../powerPoints arcane) as |pp|}}
              <span class="swadehud-pp-indicator swadehud-stat-clickable"
                    title="Power Points: {{pp.value}}/{{pp.max}} (Left click: -1, Right click: +1)"
                    data-stat-path="system.powerPoints.{{arcane}}.value"
                    data-stat-min="0"
                    data-stat-max="{{#if (gt pp.max 0)}}{{pp.max}}{{/if}}">
                <i class="fa-solid fa-bolt-lightning"></i> {{pp.value}}/{{pp.max}}
              </span>
            {{else}}
              <span class="swadehud-pp-indicator swadehud-stat-clickable"
                    title="Power Points: 0/0 (Left click: -1, Right click: +1)"
                    data-stat-path="system.powerPoints.{{arcane}}.value"
                    data-stat-min="0">
                <i class="fa-solid fa-bolt-lightning"></i> 0/0
              </span>
            {{/with}}
          {{/if}}
        </header>
        {{#each powers as |item|}}
        <div class="swadehud-item" data-item-id="{{item.id}}">
          <div class="swadehud-item-header" data-toggle="expand">
            <img class="swadehud-item-icon" src="{{item.img}}" alt="{{item.name}}" />
            <span class="swadehud-item-name">{{item.name}}</span>
          </div>
          <div class="swadehud-item-content">
            {{> shared-partials/action-buttons item=item}}
            {{#if item.effects}}
              <div class="swadehud-effects-section">
                <h4 class="effects-heading">
                  <i class="fa-solid fa-plug"></i>
                  {{localize 'SWADE.ApplicableEffects'}}
                </h4>
                <ul class="swadehud-effects-list">
                  {{#each item.effects as |effect|}}
                    <li class="swadehud-effect" data-effect-id="{{effect.id}}" data-item-id="{{item.id}}" draggable="true" title="Drag to apply {{effect.name}}">
                      <i class="fa-solid fa-hand"></i> {{effect.name}}
                    </li>
                  {{/each}}
                </ul>
              </div>
            {{/if}}
            {{!-- Debug: Check what effects properties are available --}}
            {{!-- {{#if item.effects}}Powers have item.effects{{/if}} --}}
            {{!-- {{#if item.system.effects}}Powers have item.system.effects{{/if}} --}}
            {{!-- {{#if item.appliedEffects}}Powers have item.appliedEffects{{/if}} --}}
            {{!-- Alternative: {{#each item.effects as |effect|}} --}}
            {{!--   <div>Effect: {{effect.name}}</div> --}}
            {{!-- {{/each}} --}}
            {{#if item.system.description}}
              <div class="swadehud-item-description">{{localize 'SWADE.LoadingDescription'}}</div>
            {{else}}
              <div class="swadehud-item-description swadehud-no-description">{{localize 'SWADE.NoDescription'}}</div>
            {{/if}}
          </div>
        </div>
        {{/each}}
      </div>
    {{/each}}
  </div>
</div>
