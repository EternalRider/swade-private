<header class="swadehud-section-header">
  <span class="swadehud-section-name">{{localize 'SWADE.Armor'}}</span>
</header>
<div class="swadehud-item-list">
  {{#each actor.items as |item|}}
    {{#if (eq item.type "armor")}}
      <div class="swadehud-item" data-item-id="{{item.id}}">
        <div class="swadehud-item-header" data-toggle="expand">
          <img class="swadehud-item-icon" src="{{item.img}}" alt="{{item.name}}" />
          <span class="swadehud-item-name">{{item.name}}</span>
            <span class="swadehud-equip-indicator swadehud-stat-clickable"
                  title="{{#if (eq item.system.equipStatus 0)}}{{localize 'SWADE.ItemEquipStatus.Stored'}} (Left: Carry, Right: {{#if (eq item.type 'weapon')}}Off Hand{{else}}Equip{{/if}}){{else if (eq item.system.equipStatus 1)}}{{localize 'SWADE.ItemEquipStatus.Carried'}} (Left: {{#if (eq item.type 'weapon')}}Main Hand{{else}}Equip{{/if}}, Right: Store){{else if (eq item.system.equipStatus 4)}}{{localize 'SWADE.ItemEquipStatus.MainHand'}} (Left: Two Hands, Right: Carry){{else if (eq item.system.equipStatus 5)}}{{localize 'SWADE.ItemEquipStatus.TwoHands'}} (Left: Off Hand, Right: Main Hand){{else if (eq item.system.equipStatus 2)}}{{localize 'SWADE.ItemEquipStatus.OffHand'}} (Left: Store, Right: Two Hands){{else if (eq item.system.equipStatus 3)}}{{localize 'SWADE.ItemEquipStatus.Equipped'}} (Left: Store, Right: Carry){{else}}{{localize 'SWADE.ItemEquipStatus.Stored'}} (Left: Carry, Right: {{#if (eq item.type 'weapon')}}Off Hand{{else}}Equip{{/if}}){{/if}}"
                  data-item-id="{{item.id}}"
                  data-equip-status="{{item.system.equipStatus}}">
              <i class="fa-solid fa-hand"></i>
              {{localize (equipStatus item.system.equipStatus)}}
            </span>
        </div>
        <div class="swadehud-item-content">
          <div class="swadehud-action-buttons">
            {{#if item.system.actions.additional}}
              {{#each item.system.actions.additional as |action id|}}
                {{#if (eq action.type "macro")}}
                  <button class="swadehud-action-macro" data-action="{{id}}" data-item-id="{{item.id}}" data-tooltip="{{localize 'SWADE.HUD.RunMacroTooltip' name=action.name}}">
                    {{action.name}}
                  </button>
                {{/if}}
              {{/each}}
            {{/if}}
            <button class="swadehud-chat" data-item-id="{{item.id}}" data-tooltip="SWADE.ShowInChat">
              {{localize 'SWADE.ShowInChat'}}
            </button>
          </div>
          {{#if item.system.description}}
            <div class="swadehud-item-description">{{localize 'SWADE.LoadingDescription'}}</div>
          {{else}}
            <div class="swadehud-item-description swadehud-no-description">{{localize 'SWADE.NoDescription'}}</div>
          {{/if}}
        </div>
      </div>
    {{/if}}
  {{/each}}
</div>

<header class="swadehud-section-header">
  <span class="swadehud-section-name">{{localize 'SWADE.Shields'}}</span>
</header>
<div class="swadehud-item-list">
  {{#each actor.items as |item|}}
    {{#if (eq item.type "shield")}}
      <div class="swadehud-item" data-item-id="{{item.id}}">
        <div class="swadehud-item-header" data-toggle="expand">
          <img class="swadehud-item-icon" src="{{item.img}}" alt="{{item.name}}" />
          <span class="swadehud-item-name">{{item.name}}</span>
          {{#if (eq item.system.equipStatus 3)}}
            <span class="swadehud-item-equipped">{{localize 'SWADE.ItemEquipStatus.Equipped'}}</span>
          {{/if}}
        </div>
        <div class="swadehud-item-content">
          <div class="swadehud-action-buttons">
            {{#if item.system.actions.additional}}
              {{#each item.system.actions.additional as |action id|}}
                {{#if (eq action.type "macro")}}
                  <button class="swadehud-action-macro" data-action="{{id}}" data-item-id="{{item.id}}" data-tooltip="{{localize 'SWADE.HUD.RunMacroTooltip' name=action.name}}">
                    {{action.name}}
                  </button>
                {{/if}}
              {{/each}}
            {{/if}}
            <button class="swadehud-equip" data-item-id="{{item.id}}" title="{{#if (eq item.system.equipStatus 0)}}{{localize 'SWADE.ItemEquipStatus.Carried'}}{{else if (eq item.system.equipStatus 1)}}{{localize 'SWADE.ItemEquipStatus.Equipped'}}{{else if (eq item.system.equipStatus 3)}}{{localize 'SWADE.ItemEquipStatus.Stored'}}{{else}}{{localize 'SWADE.ItemEquipStatus.Stored'}}{{/if}} {{localize 'SWADE.Shields'}}">
              {{#if (eq item.system.equipStatus 0)}}{{localize 'SWADE.ItemEquipStatus.Carried'}}{{else if (eq item.system.equipStatus 1)}}{{localize 'SWADE.ItemEquipStatus.Equipped'}}{{else if (eq item.system.equipStatus 3)}}{{localize 'SWADE.ItemEquipStatus.Stored'}}{{else}}{{localize 'SWADE.ItemEquipStatus.Stored'}}{{/if}}
            </button>
            <button class="swadehud-chat" data-item-id="{{item.id}}" data-tooltip="SWADE.ShowInChat">
              {{localize 'SWADE.ShowInChat'}}
            </button>
          </div>
          {{#if item.system.description}}
            <div class="swadehud-item-description">{{localize 'SWADE.LoadingDescription'}}</div>
          {{else}}
            <div class="swadehud-item-description swadehud-no-description">{{localize 'SWADE.NoDescription'}}</div>
          {{/if}}
        </div>
      </div>
    {{/if}}
  {{/each}}
</div>
</div>
