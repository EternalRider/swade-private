                    {{#if (eq action.type "damage")}}
                      <button class="swadehud-action-damage" data-action="{{id}}" data-item-id="{{item.id}}" title="{{localize 'SWADE.Roll'}} {{localize 'SWADE.Damage'}}: {{action.name}}">
                        {{#if action.override}}{{action.override}}{{#if action.modifier}}{{signedString action.modifier}}{{/if}}{{else}}Damage{{/if}}
                      </button>
                    {{/if}}
                    {{#if (eq action.type "macro")}}
