{{!-- Traits Panel Template --}}
<div class="traits-panel">
  <div class="traits-attributes">
    <header class="swadehud-section-header">
      <span class="swadehud-section-name">{{localize 'SWADE.Attributes'}}</span>
    </header>
      <div class="swadehud-item-list">
        {{#each attributes as |attr key|}}
          <div class="swadehud-item" data-item-id="attr-{{key}}">
            <div class="swadehud-item-header" data-toggle="expand" data-type="attribute" data-key="{{key}}" title="Click to roll {{capitalize key}}">
              <span class="swadehud-item-name">{{capitalize key}} d{{attr.die.sides}}{{#if attr.die.modifier}}{{signedString attr.die.modifier}}{{/if}}</span>
              <i class="fa-solid fa-dice swadehud-roll-icon" data-type="attribute" data-key="{{key}}" title="Click to roll {{capitalize key}}"></i>
            </div>
            <div class="swadehud-item-content">
              {{#if attr.description}}
                <div class="swadehud-item-description">{{{attr.description}}}</div>
              {{else}}
                <div class="swadehud-item-description swadehud-no-description">{{localize 'SWADE.NoDescription'}}</div>
              {{/if}}
            </div>
          </div>
        {{/each}}
      </div>
    </div>
    <div class="traits-skills">
      <header class="swadehud-section-header">
        <span class="swadehud-section-name">{{localize 'SWADE.Skills'}}</span>
      </header>
      <div class="swadehud-item-list">
        {{#each skills as |skill|}}
          <div class="swadehud-item" data-item-id="{{skill.id}}">
            <div class="swadehud-item-header" data-toggle="expand">
              <img class="swadehud-item-icon" src="{{skill.img}}" alt="{{skill.name}}" />
              <span class="swadehud-item-name" data-type="skill" data-key="{{skill.id}}" title="Click to expand">{{skill.name}} d{{skill.system.die.sides}}{{#if skill.system.die.modifier}}{{signedString skill.system.die.modifier}}{{/if}}</span>
              <i class="fa-solid fa-dice swadehud-roll-icon" data-type="skill" data-key="{{skill.id}}" title="Click to roll {{skill.name}}"></i>
            </div>
            <div class="swadehud-item-content">
              {{#if skill.system.description}}
                <div class="swadehud-item-description">{{localize 'SWADE.LoadingDescription'}}</div>
              {{else}}
                <div class="swadehud-item-description swadehud-no-description">{{localize 'SWADE.NoDescription'}}</div>
              {{/if}}
            </div>
          </div>
        {{/each}}
      </div>
    </div>
  </div>
