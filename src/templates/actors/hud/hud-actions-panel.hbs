<div class="actions-panel">
  <header class="swadehud-section-header">
    <span class="swadehud-section-name">{{localize 'SWADE.Actions.Name'}}</span>
  </header>
  <div class="swadehud-item-list">
    {{#each actor.items as |item|}}
      {{#if (eq item.type "action")}}
        <div class="swadehud-item" data-item-id="{{item.id}}">
          <div class="swadehud-item-header" data-toggle="expand">
            <img class="swadehud-item-icon" src="{{item.img}}" alt="{{item.name}}" />
            <span class="swadehud-item-name">{{item.name}}</span>
          </div>
          <div class="swadehud-item-content">
            <div class="swadehud-action-buttons">
              {{#if item.system.actions.additional}}
                {{#each item.system.actions.additional as |action id|}}
                  {{#if (eq action.type "trait")}}
                    <button class="swadehud-action-trait" data-action="{{id}}" data-item-id="{{item.id}}" data-tooltip="{{localize 'SWADE.RollName' name=action.name}}">
                      {{#if action.override}}{{action.override}}{{#if action.modifier}}{{signedString action.modifier}}{{/if}}{{else}}{{action.name}}{{/if}}
                    </button>
                  {{/if}}
                  {{#if (eq action.type "resist")}}
                    <button class="swadehud-action-resist" data-action="{{id}}" data-item-id="{{item.id}}" data-tooltip="{{localize 'SWADE.ResistRollName' name=action.name}}">
                      {{#if action.override}}{{action.override}}{{#if action.modifier}}{{signedString action.modifier}}{{/if}}{{else}}{{localize 'SWADE.Resist'}}{{/if}}
                    </button>
                  {{/if}}
                  {{#if (eq action.type "damage")}}
                    <button class="swadehud-action-damage" data-action="{{id}}" data-item-id="{{item.id}}" data-tooltip="{{localize 'SWADE.RollDamageName' name=action.name}}">
                      {{#if action.override}}{{action.override}}{{#if action.modifier}}{{signedString action.modifier}}{{/if}}{{else}}{{localize 'SWADE.Dmg'}}{{/if}}
                    </button>
                  {{/if}}
                  {{#if (eq action.type "macro")}}
                    <button class="swadehud-action-macro" data-action="{{id}}" data-item-id="{{item.id}}" data-tooltip="{{localize 'SWADE.HUD.RunMacroTooltip' name=action.name}}">
                      {{action.name}}
                    </button>
                  {{/if}}
                  {{#if (eq action.type "reload")}}
                    <button class="swadehud-action-reload" data-action="{{id}}" data-item-id="{{item.id}}" data-tooltip="{{localize 'SWADE.HUD.ReloadTooltip' name=action.name}}">
                      {{localize 'SWADE.Reload'}}
                    </button>
                  {{/if}}
                  {{#if (eq action.type "consume")}}
                    <button class="swadehud-action-consume" data-action="{{id}}" data-item-id="{{item.id}}" data-tooltip="{{localize 'SWADE.HUD.UseConsumableTooltip' name=action.name}}">
                      {{localize 'SWADE.Consumable.Use'}}
                    </button>
                  {{/if}}
                {{/each}}
              {{/if}}
              {{#if item.system.templates}}
                {{#if item.system.templates.scone}}
                  <button class="swadehud-action-template" data-item-id="{{item.id}}" data-action="template" data-template="swscone" data-tooltip="SWADE.Templates.SmallCone.Place">
                    {{localize 'SWADE.Templates.SmallCone.Short'}}
                  </button>
                {{/if}}
                {{#if item.system.templates.cone}}
                  <button class="swadehud-action-template" data-item-id="{{item.id}}" data-action="template" data-template="swcone" data-tooltip="SWADE.Templates.Cone.Place">
                    {{localize 'SWADE.Templates.Cone.Short'}}
                  </button>
                {{/if}}
                {{#if item.system.templates.stream}}
                  <button class="swadehud-action-template" data-item-id="{{item.id}}" data-action="template" data-template="stream" data-tooltip="SWADE.Templates.Stream.Place">
                    {{localize 'SWADE.Templates.Stream.Short'}}
                  </button>
                {{/if}}
                {{#if item.system.templates.small}}
                  <button class="swadehud-action-template" data-item-id="{{item.id}}" data-action="template" data-template="sbt" data-tooltip="SWADE.Templates.Small.Place">
                    {{localize 'SWADE.Templates.Small.Short'}}
                  </button>
                {{/if}}
                {{#if item.system.templates.medium}}
                  <button class="swadehud-action-template" data-item-id="{{item.id}}" data-action="template" data-template="mbt" data-tooltip="SWADE.Templates.Medium.Place">
                    {{localize 'SWADE.Templates.Medium.Short'}}
                  </button>
                {{/if}}
                {{#if item.system.templates.large}}
                  <button class="swadehud-action-template" data-item-id="{{item.id}}" data-action="template" data-template="lbt" data-tooltip="SWADE.Templates.Large.Place">
                    {{localize 'SWADE.Templates.Large.Short'}}
                  </button>
                {{/if}}
              {{/if}}
              <button class="swadehud-chat" data-item-id="{{item.id}}" data-tooltip="SWADE.ShowInChat">
                {{localize 'SWADE.ShowInChat'}}
              </button>
            </div>
            {{#if item.enrichedDescription}}
              <div class="swadehud-item-description">{{{item.enrichedDescription}}}</div>
            {{else}}
              <div class="swadehud-item-description swadehud-no-description">{{localize 'SWADE.NoDescription'}}</div>
            {{/if}}
            {{!-- Debug: {{json item.system.actions}} --}}
            {{!-- Alternative: {{item.system.actions.trait.name}} --}}
            {{!-- Alternative: {{item.system.trait}} --}}
          </div>
        </div>
      {{/if}}
    {{/each}}
  </div>
</div>