<div class="swadehud-popout-content">
  <div class="swadehud-bio-content">
    {{#if system.details.biography.enrichedValue}}
    <div class="swadehud-bio-section">
      <header class="swadehud-section-header">
        <span class="swadehud-section-name">{{localize 'SWADE.Biography'}}</span>
    </header>
      <div class="swadehud-bio-text">{{{system.details.biography.enrichedValue}}}</div>
    </div>
    {{/if}}
    {{#if system.details.enrichedNotes}}
    <div class="swadehud-bio-section">
      <header class="swadehud-section-header">
        <span class="swadehud-section-name">{{localize 'SWADE.Notes'}}</span>
    </header>
      <div class="swadehud-bio-text">{{{system.details.enrichedNotes}}}</div>
    </div>
    {{/if}}
    {{#unless (or system.details.biography.enrichedValue system.details.enrichedNotes)}}
    <div class="swadehud-bio-section">
      <p class="swadehud-no-bio">{{localize 'SWADE.NoDescription'}}</p>
    </div>
    {{/unless}}
  </div>
</div>
