<form autocomplete='off'>
  {{#if isActor}}
    <nav class='tabs' data-group='primary'>
      <a class='item' data-group='primary' data-tab='traits'>
        {{localize 'SWADE.Summary'}}
      </a>
      {{#if hasSettingFields}}
        <a class='item' data-group='primary' data-tab='additional-stats'>
          {{localize 'SWADE.AddStats'}}
        </a>
      {{/if}}
      <a class='item' data-group='primary' data-tab='auras'>
        {{localize 'SWADE.Auras.TabHeader'}}
      </a>
    </nav>
  {{/if}}
  <main class='sheet-body'>
    {{#if isItem}}
      <fieldset class='swid'>
        <p class='notification warning'>
          {{localize 'SWADE.SWID.ChangeWarning1'}}
        </p>
        <legend>{{localize 'SWADE.SWID.Long'}}</legend>
        <div class='form-group flexrow'>
          <input type='text' name='system.swid' value='{{doc.system.swid}}' />
          <button type='button' class='regenerate-swid'>
            <i class='fa-solid fa-arrows-rotate'></i>
          </button>
        </div>
      </fieldset>
    {{/if}}
    <section class='tab' data-group='primary' data-tab='traits'>
      {{#if isActor}}
        <!--Max Values-->
        <section>
          {{#if isNPC}}
            <div class='form-group'>
              <label for='{{doc.id}}-wildcard'>
                {{localize 'SWADE.WildCard'}}
              </label>
              <span class='form-fields'>
                <input
                  type='checkbox'
                  name='system.wildcard'
                  id='{{doc.id}}-wildcard'
                  {{checked doc.isWildcard}}
                />
              </span>
            </div>
          {{/if}}
          {{#unless isVehicle}}
            <div class='form-group'>
              <label for='{{doc.id}}-animalSmarts'>
                {{localize 'SWADE.AnimalSmarts'}}
              </label>
              <span class='form-fields'>
                <input
                  type='checkbox'
                  name='system.attributes.smarts.animal'
                  id='{{doc.id}}-animalSmarts'
                  {{checked doc.system.attributes.smarts.animal}}
                />
              </span>
            </div>
            <div class='form-group'>
              <label>{{localize 'SWADE.Adv'}}</label>
              <span class='form-fields'>
                <select name='system.advances.mode'>
                  {{selectOptions
                    advanceTypes
                    selected=doc.system.advances.mode
                    localize=true
                  }}
                </select>
              </span>
            </div>
            <div class='form-group'>
              <label>{{localize 'SWADE.BasePace'}}</label>
              <span class='form-fields'>
                <input
                  type='number'
                  name='system.stats.speed.value'
                  value='{{doc.system.stats.speed.value}}'
                />
              </span>
            </div>
            <div class='form-group'>
              <label>{{localize 'SWADE.RunningDie'}}</label>
              <span class='form-fields'>
                <select
                  class='running-die'
                  name='system.stats.speed.runningDie'
                  data-dtype='Number'
                >
                  {{#select doc.system.stats.speed.runningDie}}
                    <option value='1'>1</option>
                    <option value='4'>d4</option>
                    <option value='6'>d6</option>
                    <option value='8'>d8</option>
                    <option value='10'>d10</option>
                    <option value='12'>d12</option>
                  {{/select}}
                </select>
                <input
                  type='text'
                  name='system.stats.speed.runningMod'
                  value='{{signedString doc.system.stats.speed.runningMod}}'
                  data-dtype='Number'
                />
              </span>
            </div>
          {{/unless}}
          <div class='form-group'>
            <label>{{localize 'SWADE.WoundsMax'}}</label>
            <span class='form-fields'>
              <input
                type='number'
                name='system.wounds.max'
                value='{{doc.system.wounds.max}}'
              />
            </span>
          </div>
          {{#unless isVehicle}}
            <div class='form-group'>
              <label>{{localize 'SWADE.FatigueMax'}}</label>
              <span class='form-fields'>
                <input
                  type='number'
                  name='system.fatigue.max'
                  value='{{doc.system.fatigue.max}}'
                  data-dtype='number'
                />
              </span>
            </div>
          {{/unless}}
          <div class='form-group'>
            <label>{{localize 'SWADE.BenniesMax'}}</label>
            <span class='form-fields'>
              <input
                class='bennies-max'
                name='system.bennies.max'
                type='number'
                value='{{doc.system.bennies.max}}'
              />
            </span>
          </div>
          <div class='form-group'>
            <label>{{localize 'SWADE.IgnWounds'}}</label>
            <span class='form-fields'>
              <input
                name='system.wounds.ignored'
                type='number'
                value='{{doc.system.wounds.ignored}}'
              />
            </span>
          </div>
          {{#unless isVehicle}}
            <div class='form-group'>
              <label>{{localize 'SWADE.IgnFatigue'}}</label>
              <span class='form-fields'>
                <input
                  name='system.fatigue.ignored'
                  type='number'
                  value='{{doc.system.fatigue.ignored}}'
                />
              </span>
            </div>
            <div class='form-group'>
              <label>
                {{localize 'SWADE.EffectCallbacks.Shaken.UnshakeModifier'}}
              </label>
              <span class='form-fields'>
                <input
                  name='system.attributes.spirit.unShakeBonus'
                  type='number'
                  value='{{doc.system.attributes.spirit.unShakeBonus}}'
                />
              </span>
            </div>
            <div class='form-group'>
              <label>
                {{localize 'SWADE.DamageApplicator.SoakModifier'}}
              </label>
              <span class='form-fields'>
                <input
                  name='system.attributes.vigor.soakBonus'
                  type='number'
                  value='{{doc.system.attributes.vigor.soakBonus}}'
                />
              </span>
            </div>
          {{/unless}}
          {{#if isVehicle}}
            <div class='form-group'>
              <label>{{localize 'SWADE.MaxCargo'}}</label>
              <span class='form-fields'>
                <input
                  name='system.maxCargo'
                  type='number'
                  value='{{doc.system.maxCargo}}'
                />
              </span>
            </div>
            {{#if hasModSlots}}
              <div class='form-group'>
                <label>{{localize 'SWADE.MaxMods'}}</label>
                <span class='form-fields'>
                  <input
                    name='system.maxMods'
                    type='number'
                    value='{{doc.system.maxMods}}'
                  />
                </span>
              </div>
            {{/if}}
          {{/if}}
        </section>
        <!--Initiative-->
        <section>
          <h3>{{localize 'SWADE.Init'}}</h3>
          <div class='form-group'>
            <label for='{{doc.id}}-hasLevelHeaded'>
              {{localize 'SWADE.LevelHeaded'}}
            </label>
            <span class='form-fields'>
              <input
                type='checkbox'
                name='system.initiative.hasLevelHeaded'
                id='{{doc.id}}-hasLevelHeaded'
                {{checked doc.system.initiative.hasLevelHeaded}}
              />
            </span>
          </div>
          <div class='form-group'>
            <label for='{{doc.id}}-hasImpLevelHeaded'>
              {{localize 'SWADE.ImprovedLevelHeaded'}}
            </label>
            <span class='form-fields'>
              <input
                type='checkbox'
                name='system.initiative.hasImpLevelHeaded'
                id='{{doc.id}}-hasImpLevelHeaded'
                {{checked doc.system.initiative.hasImpLevelHeaded}}
              />
            </span>
          </div>
          <div class='form-group'>
            <label for='{{doc.id}}-hasQuick'>{{localize 'SWADE.Quick'}}</label>
            <span class='form-fields'>
              <input
                type='checkbox'
                name='system.initiative.hasQuick'
                id='{{doc.id}}-hasQuick'
                {{checked doc.system.initiative.hasQuick}}
              />
            </span>
          </div>
          <div class='form-group'>
            <label for='{{doc.id}}-hasHesitant'>
              {{localize 'SWADE.Hesitant'}}
            </label>
            <span class='form-fields'>
              <input
                type='checkbox'
                name='system.initiative.hasHesitant'
                id='{{doc.id}}-hasHesitant'
                {{checked doc.system.initiative.hasHesitant}}
              />
            </span>
          </div>
        </section>
        {{#unless isVehicle}}
          <!--Automatic Calculations-->
          <section>
            <h3>{{localize 'SWADE.AutoCalc'}}</h3>
            <div class='form-group'>
              <label for='{{doc.id}}-autoCalcToughness'>
                {{localize 'SWADE.Tough'}}
              </label>
              <span class='form-fields'>
                <input
                  type='checkbox'
                  name='system.details.autoCalcToughness'
                  id='{{doc.id}}-autoCalcToughness'
                  {{checked doc.system.details.autoCalcToughness}}
                />
              </span>
              <p class='notes'>{{localize 'SWADE.InclArmor'}}</p>
            </div>
            <div class='form-group'>
              <label for='{{doc.id}}-autoCalcParry'>
                {{localize 'SWADE.Parry'}}
              </label>
              <span class='form-fields'>
                <input
                  type='checkbox'
                  name='system.details.autoCalcParry'
                  id='{{doc.id}}-autoCalcParry'
                  {{checked doc.system.details.autoCalcParry}}
                />
              </span>
              <p class='notes'>{{localize 'SWADE.AutoCalcParry'}}</p>
            </div>
          </section>
        {{/unless}}
      {{/if}}
    </section>

    {{#if hasSettingFields}}
      <section
        class='tab {{itemTabActive}}'
        data-group='primary'
        data-tab='additional-stats'
      >
        {{#if isItem}}<h2>{{localize 'SWADE.AddStats'}}</h2>{{/if}}
        <header class='form-group flexrow additionalStats-header'>
          <div>{{localize 'SWADE.AdditionalStats.Label'}}</div>
          <div class='centered'>
            {{localize 'SWADE.AdditionalStats.HasMaxValue'}}
          </div>
          <div class='centered'>{{localize 'SWADE.Enabled'}}</div>
        </header>
        {{#each settingFields as |attr key|}}
          <div class='flexrow'>
            <div style='text-align: left'>
              <label for='{{doc.id}}-{{key}}-useField'>{{attr.label}}</label>
            </div>
            <div class='centered'>
              <input type='checkbox' {{checked attr.hasMaxValue}} disabled />
            </div>
            <div class='centered'>
              <input
                type='checkbox'
                name='system.additionalStats.{{key}}.useField'
                id='{{doc.id}}-{{key}}-useField'
                {{checked attr.useField}}
              />
            </div>
          </div>
        {{/each}}
      </section>
    {{/if}}
    <section class='tab' data-group='primary' data-tab='auras'>
      <!-- User Defined Aura 1-->
      <h3>{{localize 'SWADE.Auras.UserAura1'}}</h3>
      <div class='form-group'>
        <label>{{localize 'SWADE.Auras.Enabled'}}</label>
        <input
          type='checkbox'
          name='flags.swade.auras.aura1.enabled'
          {{checked auras.auras.aura1.enabled}}
        />
      </div>
      <div class='form-group' data-tooltip='SWADE.Auras.WallConstraints.Hint'>
        <label>{{localize 'SWADE.Auras.WallConstraints.Label'}}</label>
        <input
          type='checkbox'
          name='flags.swade.auras.aura1.walls'
          {{checked auras.aura1.walls}}
        />
      </div>
      <div class='form-group slim'>
        <label>{{localize 'SWADE.Auras.Range'}}
          <span class='units'>({{auras.units}})</span></label>
        <span class='form-fields'>
          <input
            type='number'
            name='flags.swade.auras.aura1.radius'
            value='{{auras.auras.aura1.radius}}'
            min='0'
            step='1'
            placeholder='{{auras.units}}'
          />
        </span>
      </div>
      <div class='form-group'>
        <label>{{localize 'SWADE.Auras.Color'}}</label>
        <span class='form-fields'>
          {{colorPicker
            name='flags.swade.auras.aura1.color'
            value=auras.auras.aura1.color
            default=auras.defaultColor
          }}
        </span>
      </div>
      <div class='form-group slim'>
        <label>{{localize 'SWADE.Auras.Alpha'}}</label>
        <span class='form-fields'>
          {{rangePicker
            name='flags.swade.auras.aura1.alpha'
            value=auras.auras.aura1.alpha
            min=0
            max=1
            step=0.05
          }}
        </span>
      </div>
      <div class='form-group slim' data-tooltip='SWADE.Aura.Visibility.Hint'>
        <label>{{localize 'SWADE.Aura.Visibility.Label'}}</label>
        <span class='form-fields'>
          <select
            data-dtype='Number'
            data-aura-id='aura1'
            name='flags.swade.auras.aura1.visibleTo'
            size='3'
            multiple
          >
            {{selectOptions
              auras.visibilityChoices
              selected=auras.auras.aura1.visibleTo
              localize=true
              nameAttr='key'
              labelAttr='label'
            }}
          </select>
        </span>
      </div>
      <!-- User Defined Aura 2-->
      <h3>{{localize 'SWADE.Auras.UserAura2'}}</h3>
      <div class='form-group'>
        <label>{{localize 'SWADE.Auras.Enabled'}}</label>
        <input
          type='checkbox'
          name='flags.swade.auras.aura2.enabled'
          {{checked auras.auras.aura2.enabled}}
        />
      </div>
      <div class='form-group' data-tooltip='SWADE.Auras.WallConstraints.Hint'>
        <label>{{localize 'SWADE.Auras.WallConstraints.Label'}}</label>
        <input
          type='checkbox'
          name='flags.swade.auras.aura2.walls'
          {{checked auras.auras.aura2.walls}}
        />
      </div>
      <div class='form-group slim'>
        <label>{{localize 'SWADE.Auras.Range'}}
          <span class='units'>({{auras.units}})</span>
        </label>
        <span class='form-fields'>
          <input
            type='number'
            name='flags.swade.auras.aura2.radius'
            value='{{auras.auras.aura2.radius}}'
            min='0'
            step='1'
            placeholder='{{auras.units}}'
          />
        </span>
      </div>
      <div class='form-group'>
        <label>{{localize 'SWADE.Auras.Color'}}</label>
        <span class='form-fields'>
          {{colorPicker
            name='flags.swade.auras.aura2.color'
            value=auras.auras.aura2.color
            default=defaultColor
          }}
        </span>
      </div>
      <div class='form-group slim'>
        <label>{{localize 'SWADE.Auras.Alpha'}}</label>
        <span class='form-fields'>
          {{rangePicker
            name='flags.swade.auras.aura2.alpha'
            value=auras.auras.aura2.alpha
            min=0
            max=1
            step=0.05
          }}
        </span>
      </div>
      <div class='form-group slim' data-tooltip='SWADE.Aura.Visibility.Hint'>
        <label>{{localize 'SWADE.Aura.Visibility.Label'}}</label>
        <span class='form-fields'>
          <select
            data-dtype='Number'
            data-aura-id='aura2'
            name='flags.swade.auras.aura2.visibleTo'
            size='3'
            multiple
          >
            {{selectOptions
              auras.visibilityChoices
              selected=auras.auras.aura2.visibleTo
              localize=true
              nameAttr='key'
              labelAttr='label'
            }}
          </select>
        </span>
      </div>
    </section>
  </main>
  <footer class='sheet-footer'>
    <button type='submit'>
      <i class='fas fa-save'></i>{{localize 'Save Changes'}}
    </button>
  </footer>
</form>