{{#if limitedUses}}
<div class='limited-uses-summary'>
  <ul class='limited-use-list'>
    <li class='limited-use-row'>
      <span><strong>{{localize "SWADE.LimitedUses"}}</strong></span>
      <span><strong>{{localize "SWADE.RechargeType"}}</strong></span>
      <span><strong>{{localize "SWADE.Uses"}}</strong></span>
    </li>
    {{#each limitedUses}}
      <li class='limited-use-row'>
        <span>{{limitedUse.name}}</span>
        <span>{{localize rechargeType}}</span>
        <span class='use-fields'>
          <input type='number' name="system.limitedUses.{{id}}.remaining" value='{{limitedUse.remaining}}' placeholder='0' data-name="system.limitedUses.{{id}}.remaining"/>
          <strong class="flex-separator">/</strong>
          <input type='number' name="system.limitedUses.{{id}}.max" value='{{limitedUse.max}}' placeholder='0' data-name="system.limitedUses.{{id}}.max"/>
          <button type='button' class='limited-use-recharge-manual invisible' title='{{localize "Recharge"}}' data-limited-use-id='{{id}}'>
            <i class='fas fa-rotate-right'></i>
          </button>
        </span>
      </li>
    {{/each}}
  </ul>
</div>
{{/if}}