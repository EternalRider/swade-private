<li class='gear-card item shield' data-item-id='{{item.id}}' data-document-class='Item'>
  <header class='flexrow card-header'>
    <div class='item-image' style="background-image: url('{{item.img}}')"></div>
    <h4 class='item-name'>{{item.name}}</h4>
    <div class='item-controls'>
      <a class='item-control item-show' data-action='showItem'><i class='fas fa-eye'></i></a>
      {{#if item.isOwner}}
        <a class='item-control item-edit' data-action='openItem' title='{{localize "SWADE.Ed"}}'><i
            class='fas fa-edit'
          ></i></a>
        <a class='item-control item-delete' data-action='deleteItem' title='{{localize "SWADE.Del"}}'><i
            class='fas fa-trash'
          ></i></a>
      {{/if}}
    </div>
  </header>
  <div class='card-content collapsed'>
    <div>
      <div class='flexrow'>
        <div>{{localize 'SWADE.Parry'}}: {{item.system.parry}}</div>
        <div>{{localize 'SWADE.Cover._name'}}: {{item.system.cover}}</div>
      </div>
      <div class='chips'>
        {{localize 'SWADE.Notes'}}:
        {{item.system.notes}}
      </div>
    </div>
  </div>
</li>