    </div>
    <div class='hq-maintenance'>
      <header class='hq-form-part section-header'>
        {{localize 'SWADE.Headquarters.Maintenance'}}
      </header>
      <div class='hq-form-part editor-wrapper'>
        {{editor
          enriched.form.maintenance
          target='system.form.maintenance'
          editable=true
          button=false
          engine='prosemirror'
          collaborate=true
        }}
      </div>
    </div>
  </section>
  <section class='hq-upgrades'>
    <header class='hq-upgrades section-header'>
      {{localize 'SWADE.Headquarters.Upgrades'}}
    </header>
    <div class='hq-upgrades editor-wrapper'>
      {{editor
        enriched.upgrades
        target='system.upgrades'
        editable=true
        button=false
        engine='prosemirror'
        collaborate=true
