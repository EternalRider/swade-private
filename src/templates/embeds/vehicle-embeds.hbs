<div>
    <section>
        <table>
            <thead>
                <tr>
                    <th colspan="6">
                        {{parent.name}}
                    </th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>{{localize 'SWADE.Size'}}</td>
                    <td>{{localize 'SWADE.Handling'}}</td>
                    <td>{{localize 'SWADE.Topspeed'}}</td>
                    <td>{{localize 'SWADE.Tough'}}</td>                
                    <td>{{localize 'SWADE.Crew'}}</td>
                    <td>{{localize 'SWADE.Price'}}</td>
                </tr>            
                <tr>
                    <td>{{size}}</td>
                    <td>{{signedString handling}}</td>
                    <td>{{topspeed.value}}</td>
                    <td>{{toughness.total}}{{#if toughness.armor}}&nbsp;({{toughness.armor}}){{/if}}</td>                
                    <td>{{crew.required.max}}</td>
                    <td>{{cost}}</td>
                </tr>
            </tbody>
        </table>
    </section>
    {{#if notes}}
    <section>
        <div><span>{{localize 'SWADE.Notes'}}:&nbsp;</span>{{notes}}</div>
    </section>
    {{/if}}
    <section>
        {{{enrichedDescription}}}
    </section>
</div>
