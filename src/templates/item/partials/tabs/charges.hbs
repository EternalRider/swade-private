<header class='header'>
  <div class='header-buttons'>
    <button type='button' class='add-charge add-button invisible'>
      <i class='fa fa-plus'></i>
      {{localize 'SWADE.AddCharge'}}
    </button>
    <button type='button' class='charge-recharge-encounter invisible'>
      <i class='fa fa-rotate-right'></i>
      {{localize 'SWADE.Encounter'}}
    </button>
    <button type='button' class='charge-recharge-day invisible'>
      <i class='fa fa-rotate'></i>
      {{localize 'SWADE.Day'}}
    </button>
  </div>
</header>
<ol class='charges-list unmarked-list'>
  {{#each item.system.charges.sorted}}
    <li>
      <fieldset class='charge' data-charge-id='{{id}}'>
        <span class='content'>
          <div class='form-group'>
            <label>{{localize 'SWADE.Name'}}</label>
            <input type='text' name='system.charges.charges.{{id}}.name' value='{{name}}' placeholder='{{localize "SWADE.Name"}}' />
          </div>
          <div class='form-group'>
            <label>{{localize 'SWADE.RechargeType'}}</label>
            <select name='system.charges.charges.{{id}}.rechargeType'>
              {{selectOptions
                  @root.chargeRechargeTypes
                  selected=rechargeType
                  localize=true
                }}
            </select>
          </div>
          <div class='form-group'>
            <label>{{localize 'SWADE.Uses'}}</label>
            <span class='form-fields text-center'>
              <input type='number' name="system.charges.charges.{{id}}.value" value='{{value}}' placeholder='0'/>
              <strong class="flex-separator">/</strong>
              <input type='number'  name="system.charges.charges.{{id}}.max" value='{{max}}' placeholder='0' />
            </span>
          </div>
          <div class='form-group'>
            <label>{{localize 'SWADE.RechargeAmount'}}</label>
            <span class='form-fields text-center'>
              <input type='text' class='recharge-amount' name='system.charges.charges.{{id}}.rechargeAmount' value='{{rechargeAmount}}' placeholder='{{localize "SWADE.Max"}}' />
              <button type='button' class='charge-recharge-manual invisible' title='{{localize "Recharge"}}' data-charge-id='{{id}}'>
                <i class='fas fa-rotate-right'></i>
              </button>
            </span>
          </div>
        </span>
        <button type='button' class='charge-delete invisible' title='{{localize "Delete"}}' data-charge-id='{{id}}' {{#if (eq ../item.system.charges.size 1)}}style='visibility: hidden;'{{/if}}>
          <i class='fas fa-trash fa-2x'></i>
        </button>
      </fieldset>
    </li>
  {{/each}}
</ol>