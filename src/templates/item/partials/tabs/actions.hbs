<header class='header'>
  <button type='button' class='add-action add-button invisible'>
    <i class='fa fa-plus'></i>
    {{localize 'SWADE.AddAction'}}
  </button>
</header>
<ol class='actions-list unmarked-list collapsibles'>
  {{#each item.system.actions.additional as |action id|}}
    <li>
      <details
        class='action'
        data-action-id='{{id}}'
        {{collapsible @root.collapsibleStates.actions id}}
      >
        <summary>{{action.name}}</summary>
        <span class='content'>
          <div class='form-group action-name'>
            <label>{{localize 'SWADE.Name'}}</label>
            <input
              type='text'
              name='system.actions.additional.{{id}}.name'
              value='{{action.name}}'
            />
          </div>
          <div class='form-group action-type'>
            <label>{{localize 'Type'}}</label>
            <select name='system.actions.additional.{{id}}.type'>
              {{#select action.type}}
                {{selectOptions
                  @root.actionTypes
                  selected=action.type
                  localize=true
                }}
              {{/select}}
            </select>
          </div>
          <button
            type='button'
            class='action-delete invisible'
            title='{{localize "Delete"}}'
            data-action-id='{{id}}'
          >
            <i class='fas fa-trash fa-2x'></i>
          </button>
          {{#if (eq action.type 'trait')}}
            <div class='form-group left'>
              <label> {{localize 'SWADE.AltTrait'}}</label>
              <input
                type='text'
                name='system.actions.additional.{{id}}.traitOverride'
                value='{{action.traitOverride}}'
              />
            </div>
            <div class='form-group right' title='{{localize "SWADE.ModHint"}}'>
              <label>{{localize 'SWADE.TraitMod'}}</label>
              <input
                type='text'
                name='system.actions.additional.{{id}}.traitMod'
                value='{{action.traitMod}}'
              />
            </div>
            <div class='form-group left'>
              <label>{{localize 'SWADE.NumberOfDice.Label'}}</label>
              <input
                type='text'
                name='system.actions.additional.{{id}}.dice'
                value='{{action.dice}}'
                data-dtype='Number'
                data-tooltip='{{localize "SWADE.NumberOfDice.Hint"}}'
              />
            </div>
            <div class='form-group right'>
              {{#if (eq @root.item.type 'weapon')}}
                <label>{{localize 'SWADE.ShotsUsed'}}</label>
                <input
                  type='number'
                  name='system.actions.additional.{{id}}.resourcesUsed'
                  value='{{action.resourcesUsed}}'
                  data-dtype='Number'
                />
              {{else}}
                <label>{{localize 'SWADE.ResourcesUsed.Label'}}</label>
                <input
                  type='number'
                  name='system.actions.additional.{{id}}.resourcesUsed'
                  value='{{action.resourcesUsed}}'
                  data-dtype='Number'
                  data-tooltip='{{localize "SWADE.ResourcesUsed.Hint"}}'
                />
              {{/if}}
            </div>
          {{else if (eq action.type 'resist')}}
            <div class='form-group left'>
              <label> {{localize 'SWADE.AltTrait'}}</label>
              <input
                type='text'
                name='system.actions.additional.{{id}}.traitOverride'
                value='{{action.traitOverride}}'
              />
            </div>
            <div class='form-group right' title='{{localize "SWADE.ModHint"}}'>
              <label>{{localize 'SWADE.TraitMod'}}</label>
              <input
                type='text'
                name='system.actions.additional.{{id}}.traitMod'
                value='{{action.traitMod}}'
              />
            </div>
          {{else if (eq action.type 'damage')}}
            <div class='form-group full-width'>
              <label>{{localize 'SWADE.DmgOver'}}</label>
              <input
                type='text'
                name='system.actions.additional.{{id}}.dmgOverride'
                value='{{action.dmgOverride}}'
              />
            </div>
            <div
              class='form-group full-width'
              title='{{localize "SWADE.ModHint"}}'
            >
              <label>{{localize 'SWADE.Dmg'}}
                {{localize 'SWADE.Modifier'}}</label>
              <input
                type='text'
                name='system.actions.additional.{{id}}.dmgMod'
                value='{{action.dmgMod}}'
              />
            </div>
            <div class='form-group full-width'>
              <label>{{localize 'SWADE.HeavyWeapon'}}</label>
              <span class='form-fields'>
                <input
                  type='checkbox'
                  name='system.actions.additional.{{id}}.isHeavyWeapon'
                  {{checked action.isHeavyWeapon}}
                />
              </span>
            </div>
          {{else if (eq action.type 'macro')}}
            <div class='form-group full-width'>
              <label>UUID</label>
              <input
                type='text'
                name='system.actions.additional.{{id}}.uuid'
                value='{{action.uuid}}'
              />
            </div>
          {{/if}}
        </span>
      </details>
    </li>
  {{/each}}
</ol>