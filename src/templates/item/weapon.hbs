<form class='main-grid {{cssClass}}' autocomplete='off'>
  <figure class='grid-under gu-1'></figure>
  <figure class='grid-under gu-2'></figure>
  <figure class='grid-under gu-3'></figure>
  <figure class='grid-under gu-4'></figure>

  {{!-- Sheet Header --}}
  {{> 'systems/swade/templates/item/partials/header.hbs'}}

  {{!-- Sidebar --}}
  <section class='sheet-sidebar'>
    {{> 'systems/swade/templates/item/partials/equipped.hbs'}}
    <div class='form-group'>
      <label>{{localize 'SWADE.Range._name'}}</label>
      <span class='form-fields'>
        <input
          name='data.range'
          type='text'
          list="{{item.id}}-ranges"
          value='{{data.data.range}}'
          placeholder='{{localize "SWADE.Range._name"}}'
        />
      </span>
    </div>
    <div class='form-group'>
      <label>{{localize 'SWADE.Dmg'}}</label>
      <span class='form-fields'>
        <input
          name='data.damage'
          type='text'
          value='{{data.data.damage}}'
          placeholder='{{localize "SWADE.Dmg"}}'
        />
      </span>
    </div>
    <div class='form-group'>
      <label for='data.ap'>{{localize 'SWADE.Ap'}}</label>
      <span class='form-fields'>
        <input
          name='data.ap'
          type='number'
          value='{{data.data.ap}}'
          placeholder='{{localize "SWADE.Ap"}}'
          data-dtype='Number'
        />
      </span>
    </div>
    <div class='form-group'>
      <label for='data.shots'>{{localize 'SWADE.Mag'}}</label>
      <span class='form-fields text-center'>
        <input
          name='data.currentShots'
          type='number'
          value='{{data.data.currentShots}}'
          placeholder='{{localize "SWADE.Mag"}}'
          data-dtype="Number"
        />
        <strong class="flex-separator">/</strong>
        <input
          name='data.shots'
          type='number'
          value='{{data.data.shots}}'
          placeholder='0'
          data-dtype="Number"
        />
      </span>
    </div>
    <hr>
    {{> 'systems/swade/templates/item/partials/additional-stats.hbs'}}
  </section>

  {{!-- Sheet Tab Navigation --}}
  <nav class='tabs' data-group='main'>
    <a class='item' data-tab='description' data-group='main'>
      {{localize 'SWADE.Desc'}}
    </a>
    <a class='item' data-tab='properties' data-group='main'>
      {{localize 'SWADE.Properties'}}
    </a>
    {{#if item.isArcaneDevice}}
      <a class='item' data-tab='powers' data-group='main'>
        {{localize 'SWADE.Pow'}}
      </a>
    {{/if}}
    <a class='item' data-tab='actions'>{{localize 'SWADE.Actions'}}</a>
    <a class='item' data-tab='effects'>{{localize 'SWADE.Effects'}}</a>
  </nav>

  {{!-- Main Section --}}
  <section class='sheet-body'>
    <section class='tab description' data-group='main' data-tab='description'>
      <div></div>
      {{> 'systems/swade/templates/item/partials/tabs/description.hbs'}}
    </section>
    <section class='tab properties' data-group='main' data-tab='properties'>
      <div class="form-group">
        <label>{{localize "SWADE.Ammo"}}</label>
        <span class="form-fields">
          <input
            type="text"
            name="data.ammo"
            value="{{data.data.ammo}}"
            list="{{item.id}}-ammo"
            data-dtype="String"
            title="{{localize 'SWADE.ClickSuggestions'}}"
          />
        </span>
      </div>
      {{> 'systems/swade/templates/item/partials/action-properties.hbs'}}
      {{> 'systems/swade/templates/item/partials/bonus-damage.hbs'}}
      <div class='form-group'>
        <label>{{localize 'SWADE.ArcaneDevice'}}</label>
        <span class='form-fields'>
          <input type='checkbox' name='data.isArcaneDevice' {{checked item.isArcaneDevice}}/>
        </span>
      </div>
      <div class='form-group'>
        <label>{{localize 'SWADE.Vehicular'}}</label>
        <span class='form-fields'>
          <input type='checkbox' name='data.isVehicular'{{checked data.data.isVehicular}}/>
        </span>
      </div>
      <div class='form-group'>
        <label>{{localize 'SWADE.AutoReload'}}</label>
        <span class='form-fields'>
          <input type='checkbox' name='data.autoReload' {{checked data.data.autoReload}} />
        </span>
      </div>
      <div class="form-group"><label>{{localize "SWADE.TrademarkWeapon.Label"}}</label>
        <span class="form-fields">
          {{#select data.data.trademark}}
          <select name="data.trademark" data-dtype="Number">
            <option value="0">None</option>
            <option value="1">{{localize "SWADE.TrademarkWeapon.Regular"}}</option>
            <option value="1">{{localize "SWADE.TrademarkWeapon.Improved"}}</option>
          </select>
          {{/select}}
        </span>
      </div>
      <div class='form-group'>
        <label>{{localize 'SWADE.Parry'}}</label>
        <span class='form-fields'>
          <input
            name='data.parry'
            type='text'
            value='{{signedString data.data.parry}}'
            placeholder='{{localize "SWADE.Parry"}}'
            data-dtype='Number'
          />
        </span>
      </div>
      <div class='form-group'>
        <label for='data.rof'>{{localize 'SWADE.RoF'}}</label>
        <span class='form-fields'>
          <input
            name='data.rof'
            type='text'
            value='{{data.data.rof}}'
            placeholder='{{localize "SWADE.RoF"}}'
          />
        </span>
      </div>
      <div class='form-group'>
        <label for='data.minStr'>{{localize 'SWADE.MinStrShort'}}</label>
        <span class='form-fields'>
          <input
            name='data.minStr'
            type='text'
            value='{{data.data.minStr}}'
            placeholder='{{localize "SWADE.MinStr"}}'
          />
        </span>
      </div>
      <div class='form-group'>
        <label for='data.weight'>{{localize 'SWADE.Weight'}}</label>
        <span class='form-fields'>
          <input
            name='data.weight'
            type='text'
            value='{{data.data.weight}}'
            placeholder='{{localize "SWADE.Weight"}}'
            data-dtype='Number'
          />
        </span>
      </div>
      <div class='form-group'>
        <label>{{localize 'SWADE.Notes'}}</label>
        <span class='form-fields'>
          <input
            type='text'
            name='data.notes'
            value='{{data.data.notes}}'
            placeholder='{{localize "SWADE.Notes"}}'
          />
        </span>
      </div>
      {{#if data.data.isVehicular}}
        {{#if settingRules.modSlots}}
          <div class='form-group'>
            <label for='data.mods'>{{localize 'SWADE.ModSlots'}}</label>
            <span class='form-fields'>
              <input
                name='data.mods'
                type='number'
                value='{{data.data.mods}}'
                placeholder='{{localize "SWADE.ModSlots"}}'
                data-dtype="Number"
              />
            </span>
          </div>
        {{/if}}
      {{/if}}
    </section>
    {{#if item.isArcaneDevice}}
      <section class='tab powers' data-group='main' data-tab='powers'>
        {{> 'systems/swade/templates/item/partials/tabs/powers.hbs'}}
      </section>
    {{/if}}
    <section class='tab actions' data-group='main' data-tab='actions'>
      {{> 'systems/swade/templates/item/partials/tabs/actions.hbs'}}
    </section>
    <section class='tab effects' data-group='main' data-tab='effects'>
      {{> 'systems/swade/templates/item/partials/tabs/effects.hbs'}}
    </section>
  </section>

  <figure class='grid-cover gc-1'></figure>
  <figure class='grid-cover gc-2'></figure>
  <figure class='grid-cover gc-3'></figure>
  <figure class='grid-cover gc-4'></figure>
</form>

<datalist id="{{item.id}}-ammo">
  {{#each ammoList}}
  <option value="{{this}}" />
  {{/each}}
</datalist>

<datalist id="{{item.id}}-ranges">
  {{#each ranges}}
  <option value="{{this}}" />
  {{/each}}
</datalist>