<form class='main-grid {{cssClass}}' autocomplete='off'>
  <figure class='grid-under gu-1'></figure>
  <figure class='grid-under gu-2'></figure>
  <figure class='grid-under gu-3'></figure>
  <figure class='grid-under gu-4'></figure>

  {{!-- Sheet Header --}}
  {{> 'systems/swade/templates/item/partials/header.hbs'}}

  {{!-- Sidebar --}}
  <section class='sheet-sidebar'>
    {{> 'systems/swade/templates/item/partials/equipped.hbs'}}
    <div class='form-group'>
      <label>{{localize 'SWADE.Range._name'}}</label>
      <span class='form-fields'>
        <input
          name='system.range'
          type='text'
          list="{{item.id}}-ranges"
          value='{{item.system.range}}'
          placeholder='{{localize "SWADE.Range._name"}}'
        />
      </span>
    </div>
    <div class='form-group'>
      <label>{{localize 'SWADE.Dmg'}}</label>
      <span class='form-fields'>
        <input
          name='system.damage'
          type='text'
          value='{{item.system.damage}}'
          placeholder='{{localize "SWADE.Dmg"}}'
        />
      </span>
    </div>
    <div class='form-group'>
      <label for='system.ap'>{{localize 'SWADE.Ap'}}</label>
      <span class='form-fields'>
        <input
          name='system.ap'
          type='number'
          value='{{item.system.ap}}'
          placeholder='{{localize "SWADE.Ap"}}'
          data-dtype='Number'
        />
      </span>
    </div>
    <div class='form-group'>
      <label for='system.shots'>{{localize 'SWADE.Mag'}}</label>
      <span class='form-fields text-center'>
        <input
          name='system.currentShots'
          type='number'
          value='{{item.system.currentShots}}'
          placeholder='{{localize "SWADE.Mag"}}'
          data-dtype="Number"
        />
        <strong class="flex-separator">/</strong>
        <input
          name='system.shots'
          type='number'
          value='{{item.system.shots}}'
          placeholder='0'
          data-dtype="Number"
        />
      </span>
    </div>
    <hr>
    {{> 'systems/swade/templates/item/partials/additional-stats.hbs'}}
  </section>

  {{!-- Sheet Tab Navigation --}}
  <nav class='tabs' data-group='main'>
    <a class='item' data-tab='description' data-group='main'>
      {{localize 'SWADE.Desc'}}
    </a>
    <a class='item' data-tab='properties' data-group='main'>
      {{localize 'SWADE.Properties'}}
    </a>
    {{#if item.isArcaneDevice}}
      <a class='item' data-tab='powers' data-group='main'>
        {{localize 'SWADE.Pow'}}
      </a>
    {{/if}}
    <a class='item' data-tab='actions'>{{localize 'SWADE.Actions'}}</a>
    <a class='item' data-tab='effects'>{{localize 'SWADE.Effects'}}</a>
  </nav>

  {{!-- Main Section --}}
  <section class='sheet-body'>
    <section class='tab description' data-group='main' data-tab='description'>
      <div></div>
      {{> 'systems/swade/templates/item/partials/tabs/description.hbs'}}
    </section>
    <section class='tab properties' data-group='main' data-tab='properties'>
      <div class="form-group"><label>{{localize "SWADE.TrademarkWeapon.Label"}}</label>
        <span class="form-fields">
          <select name="system.trademark" data-dtype="Number">
            {{#select item.system.trademark}}
              {{selectOptions
                trademarkWeaponOptions
                selected=item.system.trademark
                localize=true
              }}
            {{/select}}
          </select>
        </span>
      </div>
      <div class='form-group'>
        <label>{{localize 'SWADE.Parry'}}</label>
        <span class='form-fields'>
          <input
            name='system.parry'
            type='text'
            value='{{signedString item.system.parry}}'
            placeholder='{{localize "SWADE.Parry"}}'
            data-dtype='Number'
          />
        </span>
      </div>
      <div class='form-group'>
        <label for='system.rof'>{{localize 'SWADE.RoF'}}</label>
        <span class='form-fields'>
          <input
            name='system.rof'
            type='text'
            value='{{item.system.rof}}'
            placeholder='{{localize "SWADE.RoF"}}'
          />
        </span>
      </div>
      <div class='form-group'>
        <label for='system.minStr'>{{localize 'SWADE.MinStrShort'}}</label>
        <span class='form-fields'>
          <input
            name='system.minStr'
            type='text'
            value='{{item.system.minStr}}'
            placeholder='{{localize "SWADE.MinStr"}}'
          />
        </span>
      </div>
      <div class='form-group'>
        <label for='system.weight'>{{localize 'SWADE.Weight'}}</label>
        <span class='form-fields'>
          <input
            name='system.weight'
            type='text'
            value='{{item.system.weight}}'
            placeholder='{{localize "SWADE.Weight"}}'
            data-dtype='Number'
          />
        </span>
      </div>
      <div class='form-group'>
        <label>{{localize 'SWADE.Notes'}}</label>
        <span class='form-fields'>
          <input
            type='text'
            name='system.notes'
            value='{{item.system.notes}}'
            placeholder='{{localize "SWADE.Notes"}}'
          />
        </span>
      </div>
      {{#if item.system.isVehicular}}
        {{#if settingRules.modSlots}}
          <div class='form-group'>
            <label for='system.mods'>{{localize 'SWADE.ModSlots'}}</label>
            <span class='form-fields'>
              <input
                name='system.mods'
                type='number'
                value='{{item.system.mods}}'
                placeholder='{{localize "SWADE.ModSlots"}}'
                data-dtype="Number"
              />
            </span>
          </div>
        {{/if}}
      {{/if}}
      <div class="form-group">
        <label>{{localize "SWADE.Ammo"}}</label>
        <span class="form-fields">
          <input
            type="text"
            name="system.ammo"
            value="{{item.system.ammo}}"
            list="{{item.id}}-ammo"
            data-dtype="String"
            title="{{localize 'SWADE.ClickSuggestions'}}"
          />
        </span>
      </div>
      {{> 'systems/swade/templates/item/partials/action-properties.hbs'}}
      {{> 'systems/swade/templates/item/partials/bonus-damage.hbs'}}
      <div class='form-group'>
        <label>{{localize 'SWADE.ArcaneDevice'}}</label>
        <span class='form-fields'>
          <input type='checkbox' name='system.isArcaneDevice' {{checked item.isArcaneDevice}}/>
        </span>
      </div>
      <div class='form-group'>
        <label>{{localize 'SWADE.Vehicular'}}</label>
        <span class='form-fields'>
          <input type='checkbox' name='system.isVehicular'{{checked item.system.isVehicular}}/>
        </span>
      </div>
      <div class='form-group'>
        <label>{{localize 'SWADE.AutoReload'}}</label>
        <span class='form-fields'>
          <input type='checkbox' name='system.autoReload' {{checked item.system.autoReload}} />
        </span>
      </div>
      <div class="form-group">
        <label>{{localize "SWADE.HeavyWeapon"}}</label>
        <span class="form-fields">
          <input type="checkbox" name="system.isHeavyWeapon" {{checked item.system.isHeavyWeapon}}/>
        </span>
      </div>
      <hr>
      <h4>{{localize "SWADE.Templates.Possible"}}</h4>
      <div class="column-grid three-columns">
        <div class="form-group">
          <input
            type="checkbox"
            name="system.templates.small"
            {{checked item.system.templates.small}}
            data-dtype="Boolean"
          />
          <label>{{localize 'SWADE.Templates.Small.Short'}}</label>
        </div>
        <div class="form-group">
          <input
            type="checkbox"
            name="system.templates.medium"
            {{checked item.system.templates.medium}}
            data-dtype="Boolean"
          />
          <label>{{localize 'SWADE.Templates.Medium.Short'}}</label>
        </div>
        <div class="form-group">
          <input
            type="checkbox"
            name="system.templates.large"
            {{checked item.system.templates.large}}
            data-dtype="Boolean"
          />
          <label>{{localize 'SWADE.Templates.Large.Short'}}</label>
        </div>
        <div class="form-group">
          <input
              type="checkbox"
              name="system.templates.cone"
              {{checked item.system.templates.cone}}
              data-dtype="Boolean"
            />
          <label>{{localize 'SWADE.Templates.Cone.Short'}}</label>
        </div>
        <div class="form-group">
          <input
              type="checkbox"
              name="system.templates.stream"
              {{checked item.system.templates.stream}}
              data-dtype="Boolean"
            />
          <label>{{localize 'SWADE.Templates.Stream.Short'}}</label>
        </div>
      </div>
      {{> 'systems/swade/templates/item/partials/grants.hbs'}}
    </section>
    {{#if item.isArcaneDevice}}
      <section class='tab powers' data-group='main' data-tab='powers'>
        {{> 'systems/swade/templates/item/partials/tabs/powers.hbs'}}
      </section>
    {{/if}}
    <section class='tab actions' data-group='main' data-tab='actions'>
      {{> 'systems/swade/templates/item/partials/tabs/actions.hbs'}}
    </section>
    <section class='tab effects' data-group='main' data-tab='effects'>
      {{> 'systems/swade/templates/item/partials/tabs/effects.hbs'}}
    </section>
  </section>

  <figure class='grid-cover gc-1'></figure>
  <figure class='grid-cover gc-2'></figure>
  <figure class='grid-cover gc-3'></figure>
  <figure class='grid-cover gc-4'></figure>
</form>

<datalist id="{{item.id}}-ammo">
  {{#each ammoList}}
  <option value="{{this}}" />
  {{/each}}
</datalist>

<datalist id="{{item.id}}-ranges">
  {{#each ranges}}
  <option value="{{this}}" />
  {{/each}}
</datalist>