<section class='flexrow'>
  <div class='encumbrance'>
    <span class='label'>{{localize 'SWADE.CarryWeight'}}</span>
    <span class='value'>{{formatNumber data.data.details.encumbrance.value}}
      /
      {{data.data.details.encumbrance.max}}
      {{settingrules.weightUnit}}</span>
  </div>
  <div class='form-group currency'>
    {{#if (eq settingrules.wealthType 'currency')}}
      <label>{{settingrules.currencyName}}</label>
      <span class='form-fields'>
        <input
          name='data.details.currency'
          type='text'
          data-dtype='Number'
          value='{{data.data.details.currency}}'
          placeholder='{{localize "SWADE.Currency"}}'
        />
      </span>
    {{else if (eq settingrules.wealthType 'wealthDie')}}
      <label>
        <button class='roll'>{{localize 'SWADE.WealthDie.Label'}}</button>
      </label>
      <span class='form-fields'>
        <select data-dtype='Number' name='data.details.wealth.die'>
          {{#select data.data.details.wealth.die}}
            <option value='0'>{{localize
                'SWADE.WealthDie.Broke.Label'
              }}</option>
            {{> "systems/swade/templates/die-sides-options.hbs"}}
          {{/select}}
        </select>
        <input
          type='text'
          data-dtype='Number'
          name='data.details.wealth.modifier'
          value='{{signedString data.data.details.wealth.modifier}}'
          placeholder='{{localize "SWADE.Modifier"}}'
        />
      </span>
    {{/if}}
  </div>
</section>
<section class='inventory'>

  <!-- Weapons -->
  <header class='header weapon'>
    <span class='header-name'>{{localize 'SWADE.Weapons'}}</span>
    <span class='damage'>{{localize 'SWADE.Dmg'}}</span>
    <span class='ap'>{{localize 'SWADE.Ap'}}</span>
    <span class='note' style='text-align: center'>{{localize
        'SWADE.Notes'
      }}</span>
    <span class='weight'>{{localize 'SWADE.Weight'}}</span>
    <span class='item-controls'>
      <button type='button' class='item-create' data-type='weapon'>
        <i class='fa fa-plus'></i>{{localize 'SWADE.Add'}}
      </button>
    </span>
  </header>
  <ul>
    {{#each itemTypes.weapon}}
      <li class='item' data-item-id='{{id}}'>
        <span class='item-wrapper weapon'>
          <button
            type='button'
            class='item-img item-show'
            style="background-image: url('{{img}}');"
            title='{{localize "SWADE.ShowInChat"}}'
          ></button>
          <button
            type='button'
            class='name item-name'
            title='{{localize "SWADE.ExpandDescription"}}'
          >
            {{#if (gte data.data.quantity 2)}} (x{{data.data.quantity}}) {{/if}}
            {{name}}
          </button>
          <span class='damage'>
            {{#if data.data.damage}}
              <button
                type='button'
                class='damage-roll rollable'
                title='{{localize "SWADE.RollDamage"}}'
              >{{data.data.damage}}</button>
            {{/if}}
          </span>
          <span class='ap'>{{data.data.ap}}</span>
          <span class='note'>{{enrich data.data.notes}}</span>
          <span class='weight'>{{formatNumber
              (times data.data.weight data.data.quantity)
            }}</span>
          <span class='item-controls'>
            {{#if isOwner}}
              <button
                type='menu'
                class='equip-status'
                title='{{equipStatusLabel data.data.equipStatus}}'
              >
              {{equipStatus data.data.equipStatus}}
              </button>
              <button
                type='button'
                class='item-toggle'
                data-toggle='data.favorite'
                title='{{localize "SWADE.Favorite"}}'
              >
                {{#if data.data.favorite}}
                  <i class='fas fa-star'></i>
                {{else}}
                  <i class='fas fa-star item-unequipped'></i>
                {{/if}}
              </button>
              <button
                type='button'
                class='item-edit'
                title='{{localize "SWADE.Ed"}}'
              >
                <i class='fas fa-edit'></i>
              </button>
              <button
                type='button'
                class='item-delete'
                title='{{localize "SWADE.Del"}}'
              >
                <i class='fas fa-trash'></i>
              </button>
            {{/if}}
          </span>
          <div class='description'>{{enrich data.data.description}}</div>
        </span>
      </li>
    {{/each}}
  </ul>

  <!-- Armor -->
  <header class='header armor'>
    <span class='header-name'>{{localize 'SWADE.Armors'}}</span>
    <span class='bonus'>{{localize 'SWADE.Armor'}}</span>
    <span class='min-str'>{{localize 'SWADE.MinStrShort'}}</span>
    <span class='note' style='text-align: center'>{{localize
        'SWADE.Notes'
      }}</span>
    <span class='weight'>{{localize 'SWADE.Weight'}}</span>
    <span class='item-controls'>
      <button type='button' class='item-create' data-type='armor'>
        <i class='fa fa-plus'></i>{{localize 'SWADE.Add'}}
      </button>
    </span>
  </header>
  <ul>
    {{#each itemTypes.armor}}
      <li class='item' data-item-id='{{id}}'>
        <span class='item-wrapper armor'>
          <button
            type='button'
            class='item-img item-show'
            style="background-image: url('{{img}}');"
            title='{{localize "SWADE.ShowInChat"}}'
          ></button>
          <button
            type='button'
            class='name item-name'
            title='{{localize "SWADE.ExpandDescription"}}'
          >
            {{#if (gte data.data.quantity 2)}} (x{{data.data.quantity}}) {{/if}}
            {{name}}
          </button>
          <span class='bonus'> {{data.data.armor}} </span>
          <span class='min-str'>{{data.data.minStr}}</span>
          <span class='note'>{{enrich data.data.notes}}</span>
          <span class='weight'>{{formatNumber
              (times data.data.weight data.data.quantity)
            }}</span>
          <span class='item-controls'>
            {{#if isOwner}}
              <button type='menu' class='equip-status' title='{{localize "SWADE.ItemEquipStatus.Label"}}'>
                {{equipStatus data.data.equipStatus}}
              </button>
              <button
                type='button'
                class='item-toggle'
                data-toggle='data.favorite'
                title='{{localize "SWADE.Favorite"}}'
              >
                {{#if data.data.favorite}}
                  <i class='fas fa-star'></i>
                {{else}}
                  <i class='fas fa-star item-unequipped'></i>
                {{/if}}
              </button>
              <button
                type='button'
                class='item-edit'
                title='{{localize "SWADE.Ed"}}'
              >
                <i class='fas fa-edit'></i>
              </button>
              <button
                type='button'
                class='item-delete'
                title='{{localize "SWADE.Del"}}'
              >
                <i class='fas fa-trash'></i>
              </button>
            {{/if}}
          </span>
          <div class='description'>{{enrich data.data.description}}</div>
        </span>
      </li>
    {{/each}}
  </ul>

  <!-- Shields -->
  <header class='header shield'>
    <span class='header-name'>{{localize 'SWADE.Shields'}}</span>
    <span class='parry'>{{localize 'SWADE.Parry'}}</span>
    <span class='cover'>{{localize 'SWADE.Cover._name'}}</span>
    <span class='note' style='text-align: center'>{{localize
        'SWADE.Notes'
      }}</span>
    <span class='weight'>{{localize 'SWADE.Weight'}}</span>
    <span class='item-controls'>
      <button type='button' class='item-create' data-type='shield'>
        <i class='fa fa-plus'></i>{{localize 'SWADE.Add'}}
      </button>
    </span>
  </header>
  <ul>
    {{#each itemTypes.shield}}
      <li class='item' data-item-id='{{id}}'>
        <span class='item-wrapper shield'>
          <button
            type='button'
            class='item-img item-show'
            style="background-image: url('{{img}}');"
            title='{{localize "SWADE.ShowInChat"}}'
          ></button>
          <button
            type='button'
            class='name item-name'
            title='{{localize "SWADE.ExpandDescription"}}'
          >
            {{#if (gte data.data.quantity 2)}} (x{{data.data.quantity}}) {{/if}}
            {{data.name}}
          </button>
          <span class='parry'>{{data.data.parry}}</span>
          <span class='cover'>{{enrich data.data.cover}}</span>
          <span class='weight'>{{formatNumber
              (times data.data.weight data.data.quantity)
            }}</span>
          <span class='item-controls'>
            {{#if isOwner}}
              <button type='menu' class='equip-status' title='{{localize "SWADE.ItemEquipStatus.Label"}}'>
                {{equipStatus data.data.equipStatus}}
              </button>
              <button
                type='button'
                class='item-toggle'
                data-toggle='data.favorite'
                title='{{localize "SWADE.Favorite"}}'
              >
                {{#if data.data.favorite}}
                  <i class='fas fa-star'></i>
                {{else}}
                  <i class='fas fa-star item-unequipped'></i>
                {{/if}}
              </button>
              <button
                type='button'
                class='item-edit'
                title='{{localize "SWADE.Ed"}}'
              >
                <i class='fas fa-edit'></i>
              </button>
              <button
                type='button'
                class='item-delete'
                title='{{localize "SWADE.Del"}}'
              >
                <i class='fas fa-trash'></i>
              </button>
            {{/if}}
          </span>
          <div class='description'>{{enrich data.data.description}}</div>
        </span>
      </li>
    {{/each}}
  </ul>

  <!-- Consumables -->
  <header class="header consumable">
    <span class='header-name'>{{localize 'SWADE.Consumable.Consumables'}}</span>
    <span class='charges'>{{localize 'SWADE.Charges'}}</span>
    <span class='weight'>{{localize 'SWADE.Weight'}}</span>
    <span class='item-controls'>
      <button type='button' class='item-create' data-type='consumable'>
        <i class='fa fa-plus'></i>{{localize 'SWADE.Add'}}
      </button>
    </span>
  </header>
  <ul>
    {{#each itemTypes.consumable}}
    <li class="item" data-item-id='{{id}}'>
      <span class="item-wrapper consumable">
        <button
          type='button'
          class='item-img item-show'
          style="background-image: url('{{img}}');"
          title='{{localize "SWADE.ShowInChat"}}'
        ></button>
        <button
          type='button'
          class='name item-name'
          title='{{localize "SWADE.ExpandDescription"}}'
        >
          (x{{data.data.quantity}}) {{name}}
        </button>
        <span class="charges">
          <button type="button" class='rollable use-consumable' title="{{localize "SWADE.Consumable.Use"}}">
            {{data.data.charges.value}}/{{data.data.charges.max}}
          </button>
        </span>
        <span class='weight'>
          {{formatNumber (times data.data.weight data.data.quantity)}}
        </span>
        <span class='item-controls'>
          {{#if isOwner}}
            <button
              type='button'
              class='item-toggle'
              data-toggle='data.favorite'
              title='{{localize "SWADE.Favorite"}}'
            >
              {{#if data.data.favorite}}
                <i class='fas fa-star'></i>
              {{else}}
                <i class='fas fa-star item-unequipped'></i>
              {{/if}}
            </button>
            <button
              type='button'
              class='item-edit'
              title='{{localize "SWADE.Ed"}}'
            >
              <i class='fas fa-edit'></i>
            </button>
            <button
              type='button'
              class='item-delete'
              title='{{localize "SWADE.Del"}}'
            >
              <i class='fas fa-trash'></i>
            </button>
          {{/if}}
        </span>
        <div class='description'>{{enrich data.data.description}}</div>
      </span>
    </li>
    {{/each}}
  </ul>

  <!-- Misc Gear -->
  <header class='header misc'>
    <span class='header-name'>{{localize 'SWADE.Misc'}}</span>
    <span class='weight'>{{localize 'SWADE.Weight'}}</span>
    <span class='item-controls'>
      <button type='button' class='item-create' data-type='gear'>
        <i class='fa fa-plus'></i>{{localize 'SWADE.Add'}}
      </button>
    </span>
  </header>
  <ul>
    {{#each itemTypes.gear}}
      <li class='item' data-item-id='{{id}}'>
        <span class='item-wrapper misc'>
          <button
            type='button'
            class='item-img item-show'
            style="background-image: url('{{img}}');"
            title='{{localize "SWADE.ShowInChat"}}'
          ></button>
          <button
            type='button'
            class='name item-name'
            title='{{localize "SWADE.ExpandDescription"}}'
          >
            (x{{data.data.quantity}})
            {{name}}
          </button>
          <span class='weight'>
            {{formatNumber (times data.data.weight data.data.quantity)}}
          </span>
          <span class='item-controls'>
            {{#if isOwner}}
              {{#if data.data.equippable}}
                <button type='menu' class='equip-status' title='{{localize "SWADE.ItemEquipStatus.Label"}}'>
                  {{equipStatus data.data.equipStatus}}
                </button>
              {{/if}}
              <button
                type='button'
                class='item-toggle'
                data-toggle='data.favorite'
                title='{{localize "SWADE.Favorite"}}'
              >
                {{#if data.data.favorite}}
                  <i class='fas fa-star'></i>
                {{else}}
                  <i class='fas fa-star item-unequipped'></i>
                {{/if}}
              </button>
              <button
                type='button'
                class='item-edit'
                title='{{localize "SWADE.Ed"}}'
              >
                <i class='fas fa-edit'></i>
              </button>
              <button
                type='button'
                class='item-delete'
                title='{{localize "SWADE.Del"}}'
              >
                <i class='fas fa-trash'></i>
              </button>
            {{/if}}
          </span>
          <div class='description'>{{enrich data.data.description}}</div>
        </span>
      </li>
    {{/each}}
  </ul>
</section>